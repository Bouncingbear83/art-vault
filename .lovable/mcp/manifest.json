{
  "version": 1,
  "sdk_version": "0.26.1",
  "path": "/mcp",
  "auth": {
    "type": "oauth",
    "issuer": "https://tagmuypbjezynlcjvtuu.supabase.co/auth/v1",
    "accepted_audiences": [
      "authenticated"
    ]
  },
  "mcp": {
    "server": {
      "name": "art-vault",
      "version": "1.0.0",
      "title": "Art Vault"
    },
    "tools": [
      {
        "name": "create_note",
        "title": "Create note",
        "description": "Create a note in the Art360 vault. Enforces the schema constraints (Artist-scope requires artist_id; Flag requires priority) and rejects unknown tags.",
        "annotations": {
          "readOnlyHint": false,
          "destructiveHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "note_type": {
              "type": "string",
              "enum": [
                "Verdict",
                "Classification",
                "Trigger",
                "Flag",
                "Learning",
                "Playbook",
                "Lot"
              ]
            },
            "scope": {
              "type": "string",
              "enum": [
                "Artist",
                "Venue",
                "Subject",
                "Medium",
                "System",
                "Portfolio",
                "Lot"
              ]
            },
            "body": {
              "type": "string",
              "minLength": 1,
              "description": "The note text."
            },
            "artist_id": {
              "description": "Canonical slug, required when scope=Artist.",
              "type": "string"
            },
            "entity_key": {
              "description": "Venue / subject / sale_key when scope<>Artist.",
              "type": "string"
            },
            "decision": {
              "type": "string",
              "enum": [
                "Reclassify",
                "Set_Trigger",
                "Add_Vocab",
                "Patch_Taxonomy",
                "Buy",
                "Skip",
                "Monitor",
                "No_Action"
              ]
            },
            "action_status": {
              "type": "string",
              "enum": [
                "Open",
                "Actioned",
                "Superseded",
                "Wontfix",
                "Archived"
              ]
            },
            "play_type": {
              "type": "string",
              "enum": [
                "Arbitrage",
                "Quality_hold",
                "Pending",
                "NA"
              ]
            },
            "confidence": {
              "type": "string",
              "enum": [
                "High",
                "Med",
                "Low"
              ]
            },
            "priority": {
              "description": "Required when note_type=Flag.",
              "type": "string",
              "enum": [
                "P1",
                "P2",
                "P3"
              ]
            },
            "valid_from": {
              "description": "ISO date; defaults to today.",
              "type": "string"
            },
            "valid_to": {
              "description": "ISO date; null = evergreen.",
              "type": "string"
            },
            "supersedes": {
              "description": "note_id of the note this replaces.",
              "type": "string"
            },
            "source_ref": {
              "description": "dump / sale_key / csv that generated it.",
              "type": "string"
            },
            "slug": {
              "description": "Human key e.g. 2026-08-08-danby-verdict-01.",
              "type": "string"
            },
            "tags": {
              "description": "Must exist in vocab_note_tag.",
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "created_by": {
              "description": "claude | bert | app. Defaults to claude.",
              "type": "string"
            }
          },
          "required": [
            "note_type",
            "scope",
            "body"
          ]
        },
        "outputSchema": null
      },
      {
        "name": "search_notes",
        "title": "Search notes",
        "description": "Search the vault. `query` matches body, entity_key, slug and artist_id (case-insensitive substring). Excludes expired notes (valid_to < today) unless include_expired=true; always flags expired rows rather than hiding them.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "artist_id": {
              "type": "string"
            },
            "scope": {
              "type": "string",
              "enum": [
                "Artist",
                "Venue",
                "Subject",
                "Medium",
                "System",
                "Portfolio",
                "Lot"
              ]
            },
            "note_type": {
              "type": "string",
              "enum": [
                "Verdict",
                "Classification",
                "Trigger",
                "Flag",
                "Learning",
                "Playbook",
                "Lot"
              ]
            },
            "action_status": {
              "type": "string",
              "enum": [
                "Open",
                "Actioned",
                "Superseded",
                "Wontfix",
                "Archived"
              ]
            },
            "decision": {
              "type": "string",
              "enum": [
                "Reclassify",
                "Set_Trigger",
                "Add_Vocab",
                "Patch_Taxonomy",
                "Buy",
                "Skip",
                "Monitor",
                "No_Action"
              ]
            },
            "priority": {
              "type": "string",
              "enum": [
                "P1",
                "P2",
                "P3"
              ]
            },
            "tag": {
              "description": "Single tag from vocab_note_tag.",
              "type": "string"
            },
            "query": {
              "description": "Case-insensitive substring match on body, entity_key, slug and artist_id.",
              "type": "string"
            },
            "include_expired": {
              "type": "boolean"
            },
            "limit": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100
            }
          }
        },
        "outputSchema": null
      },
      {
        "name": "update_flag",
        "title": "Update flag",
        "description": "Update a note's action_status and/or priority. Keyed by note_id or slug. Use to action/supersede/archive a flag.",
        "annotations": {
          "readOnlyHint": false,
          "destructiveHint": false,
          "idempotentHint": true
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "note_id": {
              "type": "string"
            },
            "slug": {
              "type": "string"
            },
            "action_status": {
              "type": "string",
              "enum": [
                "Open",
                "Actioned",
                "Superseded",
                "Wontfix",
                "Archived"
              ]
            },
            "priority": {
              "type": "string",
              "enum": [
                "P1",
                "P2",
                "P3"
              ]
            }
          }
        },
        "outputSchema": null
      },
      {
        "name": "update_note",
        "title": "Update note",
        "description": "Update a note's tags, valid_to (review horizon) and/or action_status in place, atomically. Keyed by note_id or slug. Omitted fields are left untouched; pass tags=[] to clear all tags, or clear_valid_to=true to make the note evergreen. Unknown tags are rejected. Use this to re-tag or set an expiry without a supersede.",
        "annotations": {
          "readOnlyHint": false,
          "destructiveHint": false,
          "idempotentHint": true
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "note_id": {
              "type": "string"
            },
            "slug": {
              "type": "string"
            },
            "tags": {
              "description": "Replace the tag set; omit to leave untouched, [] to clear. Must exist in vocab_note_tag.",
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "valid_to": {
              "description": "ISO date review horizon; omit to leave unchanged.",
              "type": "string"
            },
            "clear_valid_to": {
              "description": "Set true to force valid_to null (evergreen); overrides valid_to.",
              "type": "boolean"
            },
            "action_status": {
              "description": "New status; omit to leave unchanged.",
              "type": "string",
              "enum": [
                "Open",
                "Actioned",
                "Superseded",
                "Wontfix",
                "Archived"
              ]
            }
          }
        },
        "outputSchema": null
      },
      {
        "name": "get_artist360",
        "title": "Get artist 360",
        "description": "Return the artist_360 surface (verdict facets + comps_rollup quant + open-flag count) for one artist, plus their open, non-expired notes.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "artist_id": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "artist_id"
          ]
        },
        "outputSchema": null
      },
      {
        "name": "score_lot",
        "title": "Score a lot (Lot Desk v0.6)",
        "description": "Score a single auction lot against the collector fair-value discipline: rung-ladder anchor on home-market comps, bounded quality delta, per-name K_buy, hard taste + budget gates, and a walk-away ladder. Read-only; writes nothing. Returns the full decision object (Buy / Skip / Monitor with the binding constraint).",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "artist": {
              "description": "Artist name or slug; resolved to artist_id. Omit if passing artist_id.",
              "type": "string"
            },
            "artist_id": {
              "description": "Canonical slug; skips name resolution.",
              "type": "string"
            },
            "title": {
              "type": "string"
            },
            "authorship": {
              "type": "string",
              "description": "Autograph / Attributed / After / etc. Only Autograph passes the mandate gate."
            },
            "medium_raw": {
              "type": "string",
              "description": "Verbatim catalogue medium."
            },
            "medium_class": {
              "description": "Oil / Watercolour / ...; inferred from medium_raw if omitted.",
              "type": "string"
            },
            "longest_cm": {
              "type": "number"
            },
            "subject": {
              "type": "string",
              "description": "Controlled subject vocab; used for the taste-zone gate."
            },
            "palette": {
              "type": "string",
              "description": "Sunlit / Grey / Neutral / Moonlit."
            },
            "palette_keyword_only": {
              "description": "Flag a palette call made from the title alone.",
              "type": "boolean"
            },
            "in_zone": {
              "description": "Human override; else computed from subject + per-artist overrides.",
              "type": "string",
              "enum": [
                "In",
                "Skip"
              ]
            },
            "est_low": {
              "type": "number"
            },
            "est_high": {
              "type": "number"
            },
            "currency": {
              "type": "string"
            },
            "venue": {
              "type": "string"
            },
            "sale_date": {
              "type": "string",
              "description": "ISO yyyy-mm-dd."
            },
            "bp_pct": {
              "description": "Per-house buyer's premium as a fraction; else the desk default.",
              "type": "number"
            },
            "strong_venue_candidate": {
              "type": "boolean",
              "description": "Y only if this is a good example that genuinely trades at strong venues; escalates the anchor tier."
            },
            "quality_delta": {
              "description": "Where this lot sits vs the median comp; bounded to observed dispersion. Omit => 1.0, stamped median-quality-assumed.",
              "type": "number"
            },
            "quality_delta_basis": {
              "type": "string"
            },
            "quality_override_reason": {
              "description": "Required to assert a delta outside the observed comp range.",
              "type": "string"
            },
            "condition": {
              "type": "string"
            },
            "sheet_grade": {
              "description": "Paper sleeve: 'Finished' required.",
              "type": "string"
            },
            "condition_checked": {
              "description": "True if a report / verso / UV image has been seen.",
              "type": "boolean"
            },
            "provenance_note": {
              "type": "string"
            },
            "sale_context": {
              "description": "Multiples-in-sale / pair / budget conflict prose.",
              "type": "string"
            },
            "taste_ok": {
              "type": "boolean",
              "description": "Glad to own at a fair price if it never re-rates? Hard gate."
            },
            "period_year": {
              "description": "Budget period; defaults to the sale year.",
              "type": "number"
            }
          },
          "required": [
            "title",
            "authorship",
            "medium_raw",
            "longest_cm",
            "subject",
            "palette",
            "currency",
            "venue",
            "sale_date",
            "strong_venue_candidate",
            "taste_ok"
          ]
        },
        "outputSchema": null
      },
      {
        "name": "commit_lot",
        "title": "Commit a won lot to the ledger (Lot Desk v0.6)",
        "description": "On a win: re-score the lot, then record it. Writes a Lot note (I.5 body grammar) and a positions row with the actual hammer paid and all-in cost. Flags if the hammer paid exceeded the walk-away, or if any gate had failed. Does not write the budget directly; the positions trigger keeps committed_gbp in sync.",
        "annotations": {
          "readOnlyHint": false,
          "destructiveHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "artist": {
              "type": "string"
            },
            "artist_id": {
              "type": "string"
            },
            "title": {
              "type": "string"
            },
            "authorship": {
              "type": "string"
            },
            "medium_raw": {
              "type": "string"
            },
            "medium_class": {
              "type": "string"
            },
            "longest_cm": {
              "type": "number"
            },
            "subject": {
              "type": "string"
            },
            "palette": {
              "type": "string"
            },
            "in_zone": {
              "type": "string",
              "enum": [
                "In",
                "Skip"
              ]
            },
            "currency": {
              "type": "string"
            },
            "venue": {
              "type": "string"
            },
            "sale_date": {
              "type": "string"
            },
            "bp_pct": {
              "type": "number"
            },
            "strong_venue_candidate": {
              "type": "boolean"
            },
            "quality_delta": {
              "type": "number"
            },
            "quality_override_reason": {
              "type": "string"
            },
            "condition": {
              "type": "string"
            },
            "sheet_grade": {
              "type": "string"
            },
            "condition_checked": {
              "type": "boolean"
            },
            "taste_ok": {
              "type": "boolean"
            },
            "hammer_paid_gbp": {
              "type": "number",
              "description": "The winning hammer actually paid (GBP)."
            },
            "house": {
              "description": "Saleroom; defaults to venue.",
              "type": "string"
            },
            "condition_status": {
              "description": "Condition as bought, for the ledger.",
              "type": "string"
            },
            "buy_date": {
              "description": "ISO; defaults to today.",
              "type": "string"
            },
            "rationale": {
              "description": "The glad-to-own line; else the scorer's.",
              "type": "string"
            }
          },
          "required": [
            "title",
            "authorship",
            "medium_raw",
            "longest_cm",
            "subject",
            "palette",
            "currency",
            "venue",
            "sale_date",
            "strong_venue_candidate",
            "taste_ok",
            "hammer_paid_gbp"
          ]
        },
        "outputSchema": null
      }
    ]
  }
}
